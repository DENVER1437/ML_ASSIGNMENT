# EngineMind 2.0 - Frontend Environment Variables
# In local development, leave this empty to use Vite's built-in /api proxy to http://127.0.0.1:8000
# In production on Vercel, set this to your Render backend service URL:
# Example: VITE_API_BASE_URL=https://enginemind-backend.onrender.com
VITE_API_BASE_URL=

